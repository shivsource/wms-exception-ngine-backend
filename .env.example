NODE_ENV=development
PORT=6000

# Existing MySQL/MariaDB container (service name "mysql" on the tj-net Docker network)
DATABASE_URL=mysql://root:mayank@mysql:3306/dummyw_data

LOG_LEVEL=info

# Scheduler (cron expression, default: every minute)
SCHEDULER_ENABLED=true
SCHEDULER_CRON=* * * * *

# Which LogisticsDataSource the intelligence layer runs against: "wms_database" (default,
# adapts the existing MySQL WMS) or "mock" (in-memory, empty — no DB required to boot).
# See src/adapters/index.ts and ARCHITECTURE.md.
DATA_SOURCE=wms_database
